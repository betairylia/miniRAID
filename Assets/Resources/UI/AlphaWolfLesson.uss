.alpha-lesson {
    position: absolute; right: 8px; top: 72px; width: 260px;
    padding: 10px; background-color: rgba(17, 24, 34, 0.96);
    border-left-width: 3px; border-left-color: rgb(231, 171, 87);
    color: rgb(242, 242, 242); font-size: 13px;
}
.alpha-title { font-size: 12px; color: rgb(231, 171, 87); margin-bottom: 8px; white-space: normal; }
.alpha-text { white-space: normal; margin-bottom: 8px; }
.alpha-restart { margin-top: 8px; padding: 5px; background-color: rgb(64, 88, 102); color: white; }
.alpha-restart:disabled { display: none; }
