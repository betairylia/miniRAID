  - m_Id: 1545101661249536
    m_Localized: 'Divine word: Hammer'
    m_Metadata:
      m_Items: []
  - m_Id: 1510736172490752
    m_Localized: 'Moves.



      If moves prior to any action done in this turn,
      can move freely for 3 grids (Blue).

      Otherwise, costs 1AP per grid moved
      (Purple).'
    m_Metadata:
      m_Items: []
